# 病案编码证据对照系统 · 环境变量样例（不含任何真实凭据）
# 复制为 .env 后按院内实际端点填写；.env 已被 .gitignore 排除。
# 缺任一必填项时程序 fail-fast 退出并列出缺失变量名，不会回落到 localhost / mock / example。

# ---- PACS：QIDO-RS 检查元数据（只取证据字段，不取影像本体） ----
PACS_BASE_URL=
PACS_QIDO_TOKEN=

# ---- RIS：本机 MLLP 监听端口（收 ORU^R01） ----
RIS_MLLP_LISTEN_PORT=2575

# ---- EMR：病历与病案首页读取 ----
EMR_BASE_URL=
EMR_API_TOKEN=

# ---- 病案质控系统：复核记录回写 ----
QC_BASE_URL=
QC_API_TOKEN=

# ---- 模型服务：OpenAI-compatible /chat/completions ----
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_TIMEOUT_SECONDS=30

# ---- 出站底座：超时 / 重试 / 退避 ----
HTTP_TIMEOUT_SECONDS=10
HTTP_RETRY_MAX=3
HTTP_BACKOFF_MILLIS=200

# ---- 官方在线编码字典连通性验证（可选，未配置即 not_configured） ----
NHSA_DICT_URL=
NHSA_DICT_TOKEN=
